options {
    directory "/var/cache/bind";

    listen-on {
        127.0.0.1;
        10.50.0.1;
    };

    listen-on-v6 { none; };

    allow-query {
        localhost;
        10.50.0.0/24;
    };

    recursion yes;

    allow-recursion {
        localhost;
        10.50.0.0/24;
    };

    forwarders {
        1.1.1.1;
        8.8.8.8;
    };

    dnssec-validation auto;

    auth-nxdomain no;
};
